{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Medical Assistant (CLI)",
            "type": "shell",
            "command": "python",
            "args": [
                "main.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Medical Assistant (Automated Demo)",
            "type": "shell",
            "command": "python",
            "args": [
                "main.py",
                "--demo"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Streamlit Dashboard",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "streamlit",
                "run",
                "app_streamlit.py"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Pytest Suite",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "-v",
                "tests/"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
