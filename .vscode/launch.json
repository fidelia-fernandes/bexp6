{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Medical Assistant: Interactive CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Medical Assistant: Automated Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--demo"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Streamlit: Web Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app_streamlit.py"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run All Pytest Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "${workspaceFolder}/tests/"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
